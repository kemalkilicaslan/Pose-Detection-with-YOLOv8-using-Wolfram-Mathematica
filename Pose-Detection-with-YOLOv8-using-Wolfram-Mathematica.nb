Cell["Evaluation Function", "Subsection",
 CellChangeTimes->{
  3.9126142238903923`*^9},ExpressionUUID->"68fda153-f037-4702-bc9e-\
067714c7fa80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"labels", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<Nose\>\"", ",", "\"\<LeftEye\>\"", ",", "\"\<RightEye\>\"", ",", 
     "\"\<LeftEar\>\"", ",", "\"\<RightEar\>\"", ",", "\"\<LeftShoulder\>\"", 
     ",", "\"\<RightShoulder\>\"", ",", "\"\<LeftElbow\>\"", ",", 
     "\"\<RightElbow\>\"", ",", "\"\<LeftWrist\>\"", ",", 
     "\"\<RightWrist\>\"", ",", "\"\<LeftHip\>\"", ",", "\"\<RightHip\>\"", 
     ",", "\"\<LeftKnee\>\"", ",", "\"\<RightKnee\>\"", ",", 
     "\"\<LeftAnkle\>\"", ",", "\"\<RightAnkle\>\""}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"62db9bc4-6882-42e0-ad3c-24c4987437ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"netevaluate", "[", 
    RowBox[{"net_", ",", "img_", ",", 
     RowBox[{"detectionThreshold_", ":", ".25"}], ",", 
     RowBox[{"overlapThreshold_", ":", ".5"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "imgSize", ",", "w", ",", "h", ",", "probableObj", ",", "probableBoxes",
        ",", "probableScores", ",", "probableKeypoints", ",", "max", ",", 
       "scale", ",", "padx", ",", "pady", ",", "results", ",", "nms", ",", 
       "x1", ",", "y1", ",", "x2", ",", "y2"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"define", " ", "image", " ", "dimensions"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"imgSize", "=", "640"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w", ",", "h"}], "}"}], "=", 
       RowBox[{"ImageDimensions", "[", "img", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "inference"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"net", "[", "img", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"filter", " ", "by", " ", "probability"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "very", " ", "small", " ", "probability", " ", "are", " ", 
        "thresholded"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"probableObj", "=", 
       RowBox[{"UnitStep", "[", 
        RowBox[{
         RowBox[{"results", "[", "\"\<Objectness\>\"", "]"}], "-", 
         "detectionThreshold"}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "probableBoxes", ",", "probableScores", ",", "probableKeypoints"}], 
        "}"}], "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Pick", "[", 
           RowBox[{"#", ",", "probableObj", ",", "1"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"results", "[", "\"\<Boxes\>\"", "]"}], ",", 
           RowBox[{"results", "[", "\"\<Objectness\>\"", "]"}], ",", 
           RowBox[{"results", "[", "\"\<KeyPoints\>\"", "]"}]}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Or", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "probableBoxes", "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", "probableKeypoints", "]"}], "==", "0"}]}], 
         "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"max", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"{", 
         RowBox[{"w", ",", "h"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"scale", "=", 
       RowBox[{"max", "/", "imgSize"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"padx", ",", "pady"}], "}"}], "=", 
       RowBox[{"imgSize", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"w", ",", "h"}], "}"}], "/", "max"}]}], ")"}], "/", 
         "2"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "transform", " ", "keypoints", " ", "coordinates", " ", "to", " ", 
        "fit", " ", "the", " ", "input", " ", "image", " ", "size"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"probableKeypoints", "=", 
       RowBox[{"Apply", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Clip", "[", 
               RowBox[{
                RowBox[{"Floor", "[", 
                 RowBox[{"scale", "*", 
                  RowBox[{"(", 
                   RowBox[{"#1", "-", "padx"}], ")"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "w"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Clip", "[", 
               RowBox[{
                RowBox[{"Floor", "[", 
                 RowBox[{"scale", "*", 
                  RowBox[{"(", 
                   RowBox[{"imgSize", "-", "#2", "-", "pady"}], ")"}]}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "h"}], "}"}]}], "]"}]}], 
             "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", "#3"}],
            "\[IndentingNewLine]", "}"}], "&"}], ",", "\[IndentingNewLine]", 
         "probableKeypoints", ",", 
         RowBox[{"{", "2", "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "transform", " ", "coordinates", " ", "into", " ", "rectangular", " ", 
        "boxes"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"probableBoxes", "=", 
       RowBox[{"Apply", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"x1", "=", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"scale", "*", 
                 RowBox[{"(", 
                  RowBox[{"#1", "-", 
                   RowBox[{"#3", "/", "2"}], "-", "padx"}], ")"}]}], "]"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "w"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"y1", "=", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"scale", "*", 
                 RowBox[{"(", 
                  RowBox[{"imgSize", "-", "#2", "-", 
                   RowBox[{"#4", "/", "2"}], "-", "pady"}], ")"}]}], "]"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "h"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"x2", "=", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"scale", "*", 
                 RowBox[{"(", 
                  RowBox[{"#1", "+", 
                   RowBox[{"#3", "/", "2"}], "-", "padx"}], ")"}]}], "]"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "w"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"y2", "=", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"scale", "*", 
                 RowBox[{"(", 
                  RowBox[{"imgSize", "-", "#2", "+", 
                   RowBox[{"#4", "/", "2"}], "-", "pady"}], ")"}]}], "]"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "h"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Rectangle", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x1", ",", "y1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x2", ",", "y2"}], "}"}]}], "]"}]}], 
           "\[IndentingNewLine]", ")"}], "&"}], ",", "probableBoxes", ",", 
         "1"}], "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "gather", " ", "the", " ", "boxes", " ", "of", " ", "the", " ", 
         "same", " ", "class", " ", "and", " ", "perform", " ", "non"}], "-", 
        
        RowBox[{"max", " ", "suppression"}]}], "*)"}], 
      RowBox[{"nms", "=", 
       RowBox[{
        RowBox[{
        "ResourceFunction", "[", "\"\<NonMaximumSuppression\>\"", "]"}], "[", 
        
        RowBox[{
         RowBox[{"probableBoxes", "->", "probableScores"}], ",", 
         "\"\<Index\>\"", ",", 
         RowBox[{"MaxOverlapFraction", "->", "overlapThreshold"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"Association", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"results", "[", "\"\<ObjectDetection\>\"", "]"}], "=", 
       RowBox[{"Part", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"probableBoxes", ",", "probableScores"}], "}"}], "]"}], 
         ",", "nms"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"results", "[", "\"\<KeypointEstimation\>\"", "]"}], "=", 
       RowBox[{
        RowBox[{"Part", "[", 
         RowBox[{"probableKeypoints", ",", "nms"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"results", "[", "\"\<KeypointConfidence\>\"", "]"}], "=", 
       RowBox[{
        RowBox[{"Part", "[", 
         RowBox[{"probableKeypoints", ",", "nms"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "results"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"9a28e213-ff90-4bc7-badd-d98422d3f4d4"]
}, Open  ]],

