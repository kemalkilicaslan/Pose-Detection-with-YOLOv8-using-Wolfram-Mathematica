Cell[BoxData[
 RowBox[{"HighlightImage", "[", 
  RowBox[{"testImage", ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "#", "]"}], "]"}], "->", "#"}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"keypoints", ",", 
      RowBox[{"Map", "[", 
       RowBox[{"getSkeleton", ",", "keypoints"}], "]"}], ",", 
      RowBox[{
       RowBox[{"predictions", "[", "\"\<ObjectDetection\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ImageLabels", "->", "None"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
