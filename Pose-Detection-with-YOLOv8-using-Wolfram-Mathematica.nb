Cell[BoxData[
 RowBox[{
  RowBox[{"getSkeleton", "[", "personKeypoints_", "]"}], ":=", 
  RowBox[{"Line", "[", 
   RowBox[{"DeleteMissing", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"personKeypoints", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "&"}], ",", 
       InterpretationBox[
        DynamicModuleBox[{Typeset`open = True}, 
         TemplateBox[{"List", 
           StyleBox[
           "\"jointIndices\"", "IconizedCustomName", StripOnInput -> False], 
           GridBox[{{
              RowBox[{
                TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["List", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Dimensions: \"", "IconizedLabel"], 
                "\[InvisibleSpace]", 
                TagBox[
                 RowBox[{"{", 
                   RowBox[{"18", ",", "2"}], "}"}], "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Byte count: \"", "IconizedLabel"], 
                "\[InvisibleSpace]", 
                TagBox["432", "IconizedItem"]}]}}, 
            GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
            "Column", 
            GridBoxItemSize -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
           Dynamic[Typeset`open]},
          "IconizedObject"]],
        {{1, 2}, {1, 3}, {2, 4}, {3, 5}, {1, 6}, {1, 7}, {6, 8}, {8, 10}, {7, 
        9}, {9, 11}, {6, 7}, {6, 12}, {7, 13}, {12, 13}, {12, 14}, {14, 16}, {
        13, 15}, {15, 17}},
        SelectWithContents->True,
        Selectable->False]}], "]"}], ",", "1", ",", "2"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"8017f92d-ff46-487f-bbe7-504b134fbdd1"],

