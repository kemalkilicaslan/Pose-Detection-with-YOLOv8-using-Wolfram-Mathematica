         "#2"}], "}"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"res", "[", "\"\<Objectness\>\"", "]"}], ",", "boxes"}], 
      "}"}]}], "]"}], ",", 
   RowBox[{"BaseStyle", "\[Rule]", 
    RowBox[{"{", 
