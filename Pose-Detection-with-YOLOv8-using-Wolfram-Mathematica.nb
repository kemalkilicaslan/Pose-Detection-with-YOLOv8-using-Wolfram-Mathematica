Cell[CellGroupData[{

Cell["Network Result", "Subsection",
 CellChangeTimes->{
  3.912614695703006*^9},ExpressionUUID->"3e47e3b0-5e95-44a6-9df8-\
2cf897251ac8"],

Cell["\<\
The network computes eight thousand four hundred bounding boxes, the position \
of the keypoints with their probabilities and the probability of an object \
inside the box:\
\>", "Text",
 CellChangeTimes->{
  3.912614705393836*^9},ExpressionUUID->"f7938343-f2e2-4c7c-bab1-\
63dbee5f97c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"res", "=", 
   RowBox[{
    RowBox[{
    "NetModel", "[", "\"\<YOLO V8 Pose Trained on MS-COCO Data\>\"", "]"}], 
    "[", "testImage", "]"}]}], ";"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"65042c77-5568-4144-a4c6-8e3219d82e43"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dimensions", "/@", "res"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"304bd7ed-294f-45a1-9bf6-8939dae6e869"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Boxes\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"8400", ",", "4"}], "}"}]}], ",", 
   RowBox[{"\<\"KeyPoints\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"8400", ",", "17", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"Objectness\"\>", "\[Rule]", 
    RowBox[{"{", "8400", "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.912540998194433*^9, 3.912541570415222*^9, 
  3.9125426122921762`*^9, 3.912587809772732*^9, 3.912614349109933*^9, 
  3.912614543105398*^9, 3.9126153487438717`*^9, 3.912759985129085*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"5801183c-d280-4419-b3b8-6fa15764b3ed"]
}, Open  ]],

Cell["\<\
Rescale the \[OpenCurlyDoubleQuote]KeyPoints\[CloseCurlyDoubleQuote] to the \
coordinates of the input image and visualize them scaled and colored by their \
probability measures:\
\>", "Text",
 CellChangeTimes->{
  3.9126147179107037`*^9},ExpressionUUID->"139557b0-cd1a-4b2e-bdeb-\
fdd3124e60d3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"imgSize", "=", "640"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w", ",", "h"}], "}"}], "=", 
   RowBox[{"ImageDimensions", "[", "testImage", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"max", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"{", 
     RowBox[{"w", ",", "h"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scale", "=", 
   RowBox[{"max", "/", "imgSize"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"padx", ",", "pady"}], "}"}], "=", 
   RowBox[{"imgSize", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"w", ",", "h"}], "}"}], "/", "max"}]}], ")"}], "/", 
     "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"heatpoints", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Apply", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{"scale", "*", 
               RowBox[{"(", 
                RowBox[{"#1", "-", "padx"}], ")"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "w"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{"scale", "*", 
               RowBox[{"(", 
                RowBox[{"imgSize", "-", "#2", "-", "pady"}], ")"}]}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "h"}], "}"}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], "->", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}], "[", 
          "#3", "]"}]}], "\[IndentingNewLine]", "}"}], "&"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"res", "[", "\"\<KeyPoints\>\"", "]"}], ",", 
      RowBox[{"{", "2", "}"}]}], "\[IndentingNewLine]", "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"0a92a864-17d8-4534-b6cb-80bc35c6fa86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"heatmap", "=", 
  RowBox[{"ReplaceImageValue", "[", 
   RowBox[{
    RowBox[{"ConstantImage", "[", 
     RowBox[{"1", ",", 
      RowBox[{"{", 
       RowBox[{"w", ",", "h"}], "}"}]}], "]"}], ",", "heatpoints"}], 
   "]"}]}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"1938ec37-09ac-45dc-8f3a-c8e839f9f6e1"],

