Cell["\<\
Rescale the bounding boxes to the coordinates of the input image and \
visualize them scaled by their \[OpenCurlyDoubleQuote]Objectness\
\[CloseCurlyDoubleQuote] measures:\
\>", "Text",
 CellChangeTimes->{
  3.912614746709642*^9},ExpressionUUID->"7044a6ad-95e9-44f1-a917-\
4a1c9cc4e451"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boxes", "=", 
   RowBox[{"Apply", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x1", "=", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{"Floor", "[", 
            RowBox[{"scale", "*", 
             RowBox[{"(", 
              RowBox[{"#1", "-", 
               RowBox[{"#3", "/", "2"}], "-", "padx"}], ")"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "w"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"y1", "=", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{"Floor", "[", 
            RowBox[{"scale", "*", 
             RowBox[{"(", 
              RowBox[{"imgSize", "-", "#2", "-", 
               RowBox[{"#4", "/", "2"}], "-", "pady"}], ")"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "h"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"x2", "=", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{"Floor", "[", 
            RowBox[{"scale", "*", 
             RowBox[{"(", 
              RowBox[{"#1", "+", 
               RowBox[{"#3", "/", "2"}], "-", "padx"}], ")"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "w"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"y2", "=", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{"Floor", "[", 
            RowBox[{"scale", "*", 
             RowBox[{"(", 
              RowBox[{"imgSize", "-", "#2", "+", 
               RowBox[{"#4", "/", "2"}], "-", "pady"}], ")"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "h"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Rectangle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x1", ",", "y1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x2", ",", "y2"}], "}"}]}], "]"}]}], "\[IndentingNewLine]",
        ")"}], "&"}], ",", 
     RowBox[{"res", "[", "\"\<Boxes\>\"", "]"}], ",", "1"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"505f2889-53f4-4593-96fa-7d034392b988"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics", "[", 
